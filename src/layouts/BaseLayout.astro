---
import '@/styles/global.css';
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';
import NoiseOverlay from '@/components/common/NoiseOverlay.astro';
import { portfolioConfig } from '@/config/portfolio.config';
import { withBase } from '@/utils/base';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  isHome?: boolean;
  schema?: Record<string, unknown>;
}

const {
  title = `${portfolioConfig.personal.name} | Portfólio de Arquitetura & Urbanismo`,
  description = portfolioConfig.seo?.metaDescription || portfolioConfig.personal.shortPitch,
  image = '/images/projects/01-edificio-multifunctional-paulista/prancha-1.png',
  isHome = true,
  schema: customSchema,
} = Astro.props;

const siteOrigin = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://monicascarvalho.github.io';
const canonicalURL = new URL(Astro.url.pathname, siteOrigin);
const absoluteImageURL = new URL(withBase(image), siteOrigin).toString();

// Dynamic sameAs list: Automatically includes Instagram if populated in config
const sameAsLinks = [
  portfolioConfig.contact.linkedin,
  portfolioConfig.contact.github,
  portfolioConfig.contact.instagram,
].filter((link): link is string => Boolean(link && link.trim().length > 0));

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": portfolioConfig.personal.name,
  "alternateName": portfolioConfig.personal.fullName,
  "jobTitle": "Estudante de Arquitetura e Urbanismo",
  "description": description,
  "url": siteOrigin,
  "image": absoluteImageURL,
  "affiliation": {
    "@type": "EducationalOrganization",
    "name": portfolioConfig.personal.institution
  },
  "alumniOf": {
    "@type": "EducationalOrganization",
    "name": portfolioConfig.personal.institution
  },
  "knowsAbout": [
    "Archicad",
    "Modelagem BIM",
    "QGIS",
    "Desenho Técnico",
    "AutoCAD",
    "Projetos Executivos",
    "Acessibilidade NBR 9050",
    "Legislação Imobiliária",
    "Planejamento Urbano"
  ],
  "sameAs": sameAsLinks
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": `${portfolioConfig.personal.name} - Portfólio de Arquitetura & Urbanismo`,
  "url": siteOrigin,
  "inLanguage": "pt-BR",
  "author": {
    "@type": "Person",
    "name": portfolioConfig.personal.name
  }
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Primary Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook / LinkedIn / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteImageURL} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={portfolioConfig.personal.name} />

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImageURL} />

    <!-- JSON-LD Structured Data for Search Engines & Entities -->
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    {customSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(customSchema)} />
    )}

    <!-- Preconnect Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Theme Initialization Script (Light by Default, respects stored preference) -->
    <script is:inline>
      (function () {
        const storedTheme = localStorage.getItem('theme');
        if (storedTheme === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col relative selection:bg-rose-200 selection:text-rose-950 dark:selection:bg-rose-900 dark:selection:text-white">
    <NoiseOverlay />
    <Header isHome={isHome} />
    
    <main class="flex-grow">
      <slot />
    </main>

    <Footer />
  </body>
</html>
