---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';
import { withBase } from '@/utils/base';

interface Props {
  project: CollectionEntry<'projects'>;
  prevProject?: CollectionEntry<'projects'>;
  nextProject?: CollectionEntry<'projects'>;
}

const { project, prevProject, nextProject } = Astro.props;
const { data } = project;
---

<BaseLayout
  title={`${data.title} | Monica Carvalho`}
  description={data.shortDescription}
  image={data.heroImage}
  isHome={false}
>
  <div class="pswp-gallery-context">
    <!-- Breadcrumb & Top Bar -->
    <div class="border-b border-rose-100 dark:border-white/10 bg-rose-50/40 dark:bg-obsidian-900/40 backdrop-blur-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5 flex items-center justify-between text-xs font-mono">
        <div class="flex items-center gap-2 text-gray-500 dark:text-gray-400">
          <a href={withBase('/')} class="hover:text-rose-600 dark:hover:text-rose-300 transition-colors">Início</a>
          <span>/</span>
          <a href={withBase('/projetos')} class="hover:text-rose-600 dark:hover:text-rose-300 transition-colors">Projetos</a>
          <span>/</span>
          <span class="text-rose-600 dark:text-rose-400 font-semibold truncate max-w-[200px] sm:max-w-none">{data.title}</span>
        </div>

        <a
          href={withBase('/#projetos')}
          class="inline-flex items-center gap-1.5 text-gray-600 dark:text-gray-300 hover:text-rose-600 dark:hover:text-rose-300 transition-colors"
        >
          <span>← Voltar à Galeria</span>
        </a>
      </div>
    </div>

    <!-- Main Project Slot -->
    <article class="py-10 md:py-16">
      <slot />
    </article>

    <!-- Bottom Project Navigation (Prev / Next) -->
    <div class="border-t border-rose-100 dark:border-white/10 py-10 bg-rose-50/20 dark:bg-obsidian-950/50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {prevProject ? (
            <a
              href={withBase(`/projetos/${prevProject.slug}`)}
              class="glass-card p-5 rounded-xl group flex flex-col justify-between"
            >
              <span class="font-mono text-xs text-gray-500 dark:text-gray-400 mb-1">← Projeto Anterior</span>
              <h4 class="font-display font-bold text-base text-gray-900 dark:text-white group-hover:text-rose-600 dark:group-hover:text-rose-300 transition-colors">
                {prevProject.data.title}
              </h4>
              <span class="font-mono text-xs text-rose-600 dark:text-rose-400 mt-1">{prevProject.data.category}</span>
            </a>
          ) : <div />}

          {nextProject ? (
            <a
              href={withBase(`/projetos/${nextProject.slug}`)}
              class="glass-card p-5 rounded-xl group flex flex-col justify-between text-right"
            >
              <span class="font-mono text-xs text-gray-500 dark:text-gray-400 mb-1">Próximo Projeto →</span>
              <h4 class="font-display font-bold text-base text-gray-900 dark:text-white group-hover:text-rose-600 dark:group-hover:text-rose-300 transition-colors">
                {nextProject.data.title}
              </h4>
              <span class="font-mono text-xs text-rose-600 dark:text-rose-400 mt-1">{nextProject.data.category}</span>
            </a>
          ) : <div />}
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { initPhotoSwipe } from '@/scripts/lightbox-init';
  initPhotoSwipe('.pswp-gallery-context');
</script>
