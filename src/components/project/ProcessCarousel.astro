---
interface Slide {
  image: string;
  caption: string;
}

interface Props {
  slides: Slide[];
}

const { slides } = Astro.props;
---

<div class="relative embla-carousel-wrapper">
  <!-- Top Bar with Counter and Controls -->
  <div class="flex items-center justify-between pb-3">
    <span class="font-mono text-xs text-blueprint-400">
      Evolução Volumétrica &amp; Diagramas de Partido
    </span>
    <div class="flex items-center gap-2">
      <button
        type="button"
        class="embla-prev p-2 rounded-lg border border-white/10 dark:border-white/10 light:border-black/10 bg-white/5 hover:bg-white/10 text-gray-300 dark:text-gray-300 light:text-gray-700 transition-colors"
        aria-label="Slide anterior"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
      </button>
      <button
        type="button"
        class="embla-next p-2 rounded-lg border border-white/10 dark:border-white/10 light:border-black/10 bg-white/5 hover:bg-white/10 text-gray-300 dark:text-gray-300 light:text-gray-700 transition-colors"
        aria-label="Próximo slide"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Embla Viewport -->
  <div class="embla overflow-hidden rounded-2xl glass-card">
    <div class="embla__container flex">
      {slides.map((slide, index) => (
        <div class="embla__slide flex-[0_0_100%] min-w-0 relative aspect-[16/9] bg-obsidian-950">
          <img
            src={slide.image}
            alt={slide.caption}
            class="w-full h-full object-cover"
            loading="lazy"
          />
          <div class="absolute bottom-0 inset-x-0 p-4 bg-gradient-to-t from-obsidian-950 via-obsidian-950/70 to-transparent flex items-center justify-between">
            <p class="text-xs sm:text-sm font-sans text-gray-200">
              {slide.caption}
            </p>
            <span class="text-[11px] font-mono text-blueprint-400 bg-obsidian-900/80 px-2 py-0.5 rounded border border-blueprint-400/30">
              {index + 1} / {slides.length}
            </span>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<script>
  import EmblaCarousel from 'embla-carousel';

  document.querySelectorAll('.embla-carousel-wrapper').forEach((wrapper) => {
    const emblaNode = wrapper.querySelector('.embla') as HTMLElement;
    const prevBtn = wrapper.querySelector('.embla-prev') as HTMLButtonElement;
    const nextBtn = wrapper.querySelector('.embla-next') as HTMLButtonElement;

    if (emblaNode) {
      const emblaApi = EmblaCarousel(emblaNode, { loop: true });

      if (prevBtn) prevBtn.addEventListener('click', () => emblaApi.scrollPrev());
      if (nextBtn) nextBtn.addEventListener('click', () => emblaApi.scrollNext());
    }
  });
</script>
