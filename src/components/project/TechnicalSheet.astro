---
interface Props {
  title: string;
  sheetType: string;
  scale: string;
  image: string;
  highResImage?: string;
  description: string;
}

const { title, sheetType, scale, image, highResImage, description } = Astro.props;
const zoomUrl = highResImage || image;
---

<div class="glass-card rounded-2xl overflow-hidden border border-white/10 dark:border-white/10 light:border-black/5 group">
  <!-- Image Container with PhotoSwipe Trigger -->
  <a
    href={zoomUrl}
    data-pswp-width="1200"
    data-pswp-height="800"
    target="_blank"
    class="pswp-gallery-item block relative aspect-[16/10] bg-obsidian-950 overflow-hidden cursor-zoom-in"
    title="Clique para abrir prancha com zoom e pan de alta resolução"
  >
    <img
      src={image}
      alt={title}
      class="w-full h-full object-contain object-center p-2 group-hover:scale-102 transition-transform duration-300"
      loading="lazy"
    />

    <!-- Hover Indicator: Zoom & Pan -->
    <div class="absolute inset-0 bg-obsidian-950/40 opacity-0 group-hover:opacity-100 backdrop-blur-[2px] transition-opacity flex items-center justify-center">
      <div class="px-4 py-2 rounded-xl bg-obsidian-900/90 border border-blueprint-400/50 text-blueprint-400 text-xs font-mono font-medium flex items-center gap-2 shadow-xl">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/>
        </svg>
        <span>Inspecionar Prancha (Zoom &amp; Pan)</span>
      </div>
    </div>

    <!-- Sheet Type & Scale Badges overlay -->
    <div class="absolute top-3 left-3 flex gap-2">
      <span class="px-2.5 py-1 rounded text-[11px] font-mono font-medium bg-obsidian-900/90 text-blueprint-400 border border-blueprint-400/30 backdrop-blur-md">
        {sheetType}
      </span>
      <span class="px-2.5 py-1 rounded text-[11px] font-mono font-semibold bg-obsidian-900/90 text-white border border-white/15 backdrop-blur-md">
        Escala {scale}
      </span>
    </div>
  </a>

  <!-- Sheet Legend / Description below -->
  <div class="p-5 space-y-1.5 border-t border-white/5 dark:border-white/5 light:border-black/5">
    <div class="flex items-center justify-between">
      <h4 class="font-display font-semibold text-base text-white dark:text-white light:text-gray-900">
        {title}
      </h4>
      <span class="text-[11px] font-mono text-gray-400">ABNT NBR 6492</span>
    </div>
    <p class="text-xs text-gray-400 dark:text-gray-400 light:text-gray-600 leading-relaxed">
      {description}
    </p>
  </div>
</div>
