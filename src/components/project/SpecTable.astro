---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { data } = project;
---

<div class="glass-card rounded-2xl p-6 sm:p-8 space-y-6">
  <div class="flex items-center justify-between pb-4 border-b border-white/10 dark:border-white/10 light:border-black/5">
    <div class="space-y-1">
      <span class="font-mono text-xs font-semibold text-blueprint-400 uppercase tracking-wider">
        Documentação Oficial
      </span>
      <h3 class="font-display font-bold text-xl text-white dark:text-white light:text-gray-900">
        Ficha Técnica &amp; Parâmetros de Projeto
      </h3>
    </div>
    <span class="font-mono text-xs text-gray-400 px-3 py-1 rounded-full glass-spec-item">
      {data.year} • {data.semester}
    </span>
  </div>

  <!-- Specs Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-xs font-mono">
    
    <div class="p-3.5 rounded-xl glass-spec-item space-y-1">
      <span class="text-gray-400 block text-[10px] uppercase">Tipologia / Uso</span>
      <span class="font-semibold text-white dark:text-white light:text-gray-900 text-sm">{data.category}</span>
    </div>

    <div class="p-3.5 rounded-xl glass-spec-item space-y-1">
      <span class="text-gray-400 block text-[10px] uppercase">Localização</span>
      <span class="font-semibold text-white dark:text-white light:text-gray-900 text-sm">{data.location}</span>
    </div>

    <div class="p-3.5 rounded-xl glass-spec-item space-y-1">
      <span class="text-gray-400 block text-[10px] uppercase">Área Construída</span>
      <span class="font-semibold text-blueprint-400 text-sm">{data.builtArea}</span>
    </div>

    <div class="p-3.5 rounded-xl glass-spec-item space-y-1">
      <span class="text-gray-400 block text-[10px] uppercase">Área do Lote</span>
      <span class="font-semibold text-white dark:text-white light:text-gray-900 text-sm">{data.siteArea || 'N/A'}</span>
    </div>

  </div>

  <!-- Author Role & Responsibilities (Crucial para recrutadores) -->
  <div class="p-4 rounded-xl glass-spec-item space-y-2">
    <div class="flex items-center gap-2">
      <span class="font-mono text-[11px] font-semibold text-blueprint-400 uppercase">
        Atribuição &amp; Escopo de Responsabilidade:
      </span>
    </div>
    <p class="text-xs sm:text-sm text-gray-300 dark:text-gray-300 light:text-gray-700 leading-relaxed font-sans">
      {data.authorRole}
    </p>
  </div>

  <!-- Softwares & Normas aplicadas -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    
    <!-- Softwares -->
    <div class="space-y-2">
      <span class="font-mono text-[11px] text-gray-400 uppercase block">Ferramentas Utilizadas:</span>
      <div class="flex flex-wrap gap-1.5">
        {data.softwares.map(sw => (
          <span class={`px-2.5 py-1 rounded text-[11px] font-mono ${sw.includes('ArchiCAD') ? 'bg-blueprint-500/20 text-blueprint-400 border border-blueprint-400/40 font-bold' : 'bg-white/5 text-gray-300 border border-white/10'}`}>
            {sw}
          </span>
        ))}
      </div>
    </div>

    <!-- Normas e Aprovações -->
    {data.approvalCompliance && (
      <div class="space-y-2">
        <span class="font-mono text-[11px] text-gray-400 uppercase block">Normas Técnicas &amp; Ritos Legais:</span>
        <div class="flex flex-wrap gap-1.5">
          {data.approvalCompliance.map(rule => (
            <span class="px-2.5 py-1 rounded text-[11px] font-mono bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
              {rule}
            </span>
          ))}
        </div>
      </div>
    )}

  </div>

  <!-- BIM Workflow Highlight if present -->
  {data.bimWorkflow && (
    <div class="pt-4 border-t border-white/10 dark:border-white/10 light:border-black/5">
      <div class="flex items-start gap-3 p-4 rounded-xl bg-blueprint-500/5 border border-blueprint-400/20">
        <div class="p-2 rounded-lg bg-blueprint-500/10 text-blueprint-400 shrink-0">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
          </svg>
        </div>
        <div class="space-y-1">
          <h4 class="font-display font-semibold text-sm text-blueprint-400">Destaque de Fluxo BIM (ArchiCAD)</h4>
          <p class="text-xs text-gray-300 dark:text-gray-300 light:text-gray-600 leading-relaxed font-sans">
            {data.bimWorkflow.highlight}
          </p>
        </div>
      </div>
    </div>
  )}

</div>
