---
interface Detail {
  title: string;
  detailScale: string;
  description: string;
  image: string;
}

interface Props {
  details: Detail[];
}

const { details } = Astro.props;
---

<div class="space-y-6">
  <div class="space-y-1">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-medium bg-amber-500/10 border border-amber-500/20 text-amber-400">
      <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
      <span>Diferencial de Maturidade Executiva</span>
    </div>
    <h3 class="text-2xl font-display font-bold text-white dark:text-white light:text-gray-900">
      Detalhamento Construtivo &amp; Encontros de Materiais
    </h3>
    <p class="text-xs sm:text-sm text-gray-400 dark:text-gray-400 light:text-gray-600">
      Soluções de impermeabilização, caixilharia embutida e encontros construtivos desenvolvidos para prevenção de patologias em canteiro.
    </p>
  </div>

  <div class="grid grid-cols-1 gap-6">
    {details.map((detail) => (
      <div class="glass-card rounded-2xl overflow-hidden border border-white/10 dark:border-white/10 light:border-black/5 group">
        <a
          href={detail.image}
          data-pswp-width="1200"
          data-pswp-height="800"
          target="_blank"
          class="pswp-gallery-item block relative aspect-[16/10] bg-obsidian-950 overflow-hidden cursor-zoom-in"
          title="Clique para inspecionar o detalhe construtivo com zoom"
        >
          <img
            src={detail.image}
            alt={detail.title}
            class="w-full h-full object-contain p-2 group-hover:scale-102 transition-transform duration-300"
            loading="lazy"
          />

          <!-- Scale and badge -->
          <div class="absolute top-3 left-3 flex gap-2">
            <span class="px-2.5 py-1 rounded text-[11px] font-mono font-medium bg-amber-500/20 text-amber-400 border border-amber-500/30 backdrop-blur-md">
              Detalhe Executivo
            </span>
            <span class="px-2.5 py-1 rounded text-[11px] font-mono font-semibold bg-obsidian-900/90 text-white border border-white/15 backdrop-blur-md">
              Escala {detail.detailScale}
            </span>
          </div>

          <div class="absolute inset-0 bg-obsidian-950/40 opacity-0 group-hover:opacity-100 backdrop-blur-[2px] transition-opacity flex items-center justify-center">
            <div class="px-4 py-2 rounded-xl bg-obsidian-900/90 border border-amber-400/50 text-amber-400 text-xs font-mono font-medium flex items-center gap-2 shadow-xl">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/>
              </svg>
              <span>Inspecionar Detalhe 1:10 (Zoom &amp; Pan)</span>
            </div>
          </div>
        </a>

        <div class="p-5 space-y-1.5 border-t border-white/5">
          <h4 class="font-display font-semibold text-base text-white dark:text-white light:text-gray-900">
            {detail.title}
          </h4>
          <p class="text-xs text-gray-400 dark:text-gray-400 light:text-gray-600 leading-relaxed">
            {detail.description}
          </p>
        </div>
      </div>
    ))}
  </div>
</div>
