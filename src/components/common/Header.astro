---
import { portfolioConfig } from '@/config/portfolio.config';
import { withBase } from '@/utils/base';
import ThemeToggle from './ThemeToggle.astro';
import ArchitecturalLogo from './ArchitecturalLogo.astro';

interface Props {
  isHome?: boolean;
}

const { isHome = true } = Astro.props;
const getLink = (hash: string) => isHome ? hash : withBase(`/${hash}`);
---

<header class="sticky top-0 z-50 w-full glass-nav backdrop-blur-glass transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Brand / Monograma Arquitetônico -->
    <a href={withBase('/')} class="group flex items-center gap-3 focus:outline-none" aria-label={`Página inicial - ${portfolioConfig.personal.name}`}>
      <ArchitecturalLogo size="md" />
      <div class="flex flex-col">
        <span class="font-display font-semibold tracking-tight text-base sm:text-lg text-gray-900 dark:text-white group-hover:text-rose-600 dark:group-hover:text-rose-300 transition-colors">
          {portfolioConfig.personal.name}
        </span>
        <span class="font-mono text-[11px] text-gray-500 dark:text-gray-400 tracking-wider uppercase">
          Arquitetura &amp; Urbanismo · UNIP
        </span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-6 lg:gap-8 text-sm font-medium">
      <a href={getLink('#projetos')} class="text-gray-600 dark:text-gray-300 hover:text-rose-600 dark:hover:text-rose-300 transition-colors">
        Projetos
      </a>
      <a href={getLink('#trajetoria')} class="text-gray-600 dark:text-gray-300 hover:text-rose-600 dark:hover:text-rose-300 transition-colors flex items-center gap-1.5">
        <span>Trajetória Imobiliária</span>
        <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
      </a>
      <a href={getLink('#habilidades')} class="text-gray-600 dark:text-gray-300 hover:text-rose-600 dark:hover:text-rose-300 transition-colors">
        Competências
      </a>
      <a href={getLink('#sobre')} class="text-gray-600 dark:text-gray-300 hover:text-rose-600 dark:hover:text-rose-300 transition-colors">
        Sobre
      </a>
      <a href={getLink('#contato')} class="text-gray-600 dark:text-gray-300 hover:text-rose-600 dark:hover:text-rose-300 transition-colors">
        Contato
      </a>
    </nav>

    <!-- Quick Actions (PDF Download + Theme Toggle) -->
    <div class="flex items-center gap-3">
      <!-- CV PDF Button -->
      <a
        href={withBase(portfolioConfig.downloads.cvUrl)}
        download="Curriculo-Monica-Carvalho.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg text-xs font-mono font-medium border border-rose-200 dark:border-rose-900/50 bg-rose-50/70 dark:bg-rose-950/30 text-rose-700 dark:text-rose-300 hover:bg-rose-100 dark:hover:bg-rose-900/40 hover:border-rose-300 transition-all shadow-sm"
        title="Baixar Currículo Vitae em PDF"
      >
        <svg class="w-3.5 h-3.5 text-rose-600 dark:text-rose-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <span>Baixar CV (PDF)</span>
      </a>

      <ThemeToggle />

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden p-2 rounded-lg border border-black/10 dark:border-white/10 text-gray-700 dark:text-gray-300 hover:text-rose-600 transition-colors"
        aria-label="Abrir menu de navegação"
      >
        <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div id="mobile-menu" class="hidden md:hidden px-4 pt-2 pb-6 space-y-3 border-t border-rose-100 dark:border-white/10 bg-white/95 dark:bg-obsidian-900/95 backdrop-blur-xl">
    <a href={getLink('#projetos')} class="block py-2 text-sm text-gray-800 dark:text-gray-200 hover:text-rose-600">Projetos em Destaque</a>
    <a href={getLink('#trajetoria')} class="block py-2 text-sm text-gray-800 dark:text-gray-200 hover:text-rose-600">Trajetória Imobiliária</a>
    <a href={getLink('#habilidades')} class="block py-2 text-sm text-gray-800 dark:text-gray-200 hover:text-rose-600">Competências</a>
    <a href={getLink('#sobre')} class="block py-2 text-sm text-gray-800 dark:text-gray-200 hover:text-rose-600">Sobre</a>
    <a href={getLink('#contato')} class="block py-2 text-sm text-gray-800 dark:text-gray-200 hover:text-rose-600">Contato</a>
    <div class="pt-2">
      <a href={withBase(portfolioConfig.downloads.cvUrl)} download class="flex items-center justify-center gap-2 py-2 px-3 rounded-lg text-xs font-mono font-medium border border-rose-200 dark:border-rose-900 bg-rose-50 dark:bg-rose-950/40 text-rose-700 dark:text-rose-300">
        Baixar CV (PDF)
      </a>
    </div>
  </div>
</header>

<script is:inline>
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  if (mobileBtn && mobileMenu) {
    mobileBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
    mobileMenu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => mobileMenu.classList.add('hidden'));
    });
  }
</script>
