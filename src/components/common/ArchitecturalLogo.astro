---
interface Props {
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { size = 'md', class: className = '' } = Astro.props;

const dimensionClasses = {
  sm: 'w-8 h-8',
  md: 'w-10 h-10',
  lg: 'w-14 h-14',
}[size];
---

<div class={`relative rounded-xl border border-rose-200/90 dark:border-rose-900/60 bg-gradient-to-br from-rose-50/80 to-rose-100/40 dark:from-rose-950/40 dark:to-obsidian-900/80 flex items-center justify-center p-1.5 shadow-sm group-hover:border-rose-400 dark:group-hover:border-rose-500/80 group-hover:shadow-rose-500/10 transition-all duration-300 ${dimensionClasses} ${className}`}>
  <svg
    viewBox="0 0 64 64"
    class="w-full h-full text-rose-600 dark:text-rose-400 transition-transform duration-300 group-hover:scale-105"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <!-- Background Technical Grid Line -->
    <line x1="12" y1="32" x2="52" y2="32" stroke="currentColor" stroke-width="0.7" stroke-dasharray="2 2" stroke-opacity="0.25" />
    <line x1="32" y1="12" x2="32" y2="52" stroke="currentColor" stroke-width="0.7" stroke-dasharray="2 2" stroke-opacity="0.25" />

    <!-- Monogram M: Structural Elevation & Columns -->
    <path
      d="M 16 46 L 16 20 L 26 34 L 36 20 L 36 46"
      stroke="currentColor"
      stroke-width="3.2"
      stroke-linecap="round"
      stroke-linejoin="round"
    />

    <!-- Monogram C: Sweeping Foundation Arc embracing the structure -->
    <path
      d="M 48 24 C 44 17 35 17 29 20"
      stroke="currentColor"
      stroke-width="2.2"
      stroke-linecap="round"
      stroke-opacity="0.8"
    />
    <path
      d="M 23 46 C 33 50.5 45 47.5 48 37"
      stroke="currentColor"
      stroke-width="2.2"
      stroke-linecap="round"
      stroke-opacity="0.8"
    />

    <!-- Precision Drafting Nodes -->
    <circle cx="16" cy="20" r="2" fill="currentColor" />
    <circle cx="36" cy="20" r="2" fill="currentColor" />
    <circle cx="26" cy="34" r="2" fill="currentColor" />
  </svg>
</div>
