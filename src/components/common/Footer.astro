---
import { portfolioConfig } from '@/config/portfolio.config';
import { withBase } from '@/utils/base';
import ArchitecturalLogo from './ArchitecturalLogo.astro';

const currentYear = new Date().getFullYear();
const { contact } = portfolioConfig;

const emailB64 = Buffer.from(contact.email).toString('base64');
const waB64 = Buffer.from(contact.whatsappUrl).toString('base64');
---

<footer class="w-full border-t border-rose-100 dark:border-white/10 bg-rose-50/30 dark:bg-obsidian-950/80 backdrop-blur-md pt-14 pb-10 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 pb-10 border-b border-rose-100 dark:border-white/10">
      <!-- Col 1: Bio & Status -->
      <div class="md:col-span-2 space-y-3">
        <div class="flex items-center gap-3">
          <ArchitecturalLogo size="sm" />
          <div>
            <h3 class="font-display font-semibold text-base text-gray-900 dark:text-white">
              {portfolioConfig.personal.name}
            </h3>
            <p class="font-mono text-xs text-gray-500 dark:text-gray-400">
              {portfolioConfig.personal.institution} · {portfolioConfig.personal.graduationPeriod}
            </p>
          </div>
        </div>
        <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-300 max-w-lg leading-relaxed">
          {portfolioConfig.personal.shortPitch}
        </p>
      </div>

      <!-- Col 2: Documentos & Downloads -->
      <div class="space-y-3">
        <h4 class="font-mono text-xs font-semibold tracking-wider text-rose-600 dark:text-rose-400 uppercase">
          Documentos
        </h4>
        <ul class="space-y-2 text-xs font-mono">
          <li>
            <a href={withBase(portfolioConfig.downloads.cvUrl)} download class="inline-flex items-center gap-2 text-gray-600 dark:text-gray-300 hover:text-rose-600 dark:hover:text-rose-300 transition-colors">
              <svg class="w-4 h-4 text-rose-600 dark:text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
              </svg>
              <span>Currículo Vitae (PDF)</span>
            </a>
          </li>
          <li>
            <a href={withBase('/projetos')} class="inline-flex items-center gap-2 text-gray-600 dark:text-gray-300 hover:text-rose-600 dark:hover:text-rose-300 transition-colors">
              <span>Ver Todos os Projetos →</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Conexões & Contato -->
      <div class="space-y-3">
        <h4 class="font-mono text-xs font-semibold tracking-wider text-rose-600 dark:text-rose-400 uppercase">
          Contato &amp; Redes
        </h4>
        <ul class="space-y-2 text-xs font-mono text-gray-600 dark:text-gray-300">
          <li>
            <a
              href="javascript:void(0)"
              data-footer-action="email"
              data-b64={emailB64}
              class="inline-flex items-center gap-2 hover:text-rose-600 dark:hover:text-rose-300 transition-colors cursor-pointer"
              title="Clique para enviar e-mail"
            >
              <svg class="w-3.5 h-3.5 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              <span>Enviar E-mail</span>
            </a>
          </li>
          <li>
            <a
              href="javascript:void(0)"
              data-footer-action="whatsapp"
              data-b64={waB64}
              class="inline-flex items-center gap-2 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors cursor-pointer"
              title="Abrir conversa no WhatsApp"
            >
              <svg class="w-3.5 h-3.5 text-emerald-500" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.97.53 1.838.832 2.796.832h.005c3.18 0 5.766-2.586 5.767-5.766.001-3.182-2.585-5.769-5.772-5.769zm3.376 8.211c-.147.411-.74.753-1.02.779-.27.025-.615.119-1.99-.449-1.748-.722-2.883-2.493-2.97-2.609-.088-.116-.704-.938-.704-1.789 0-.85.446-1.269.605-1.442.158-.173.346-.217.46-.217.116 0 .232.001.333.006.107.005.25-.041.391.299.146.353.5 1.22.544 1.309.044.088.073.19.015.305-.059.116-.088.188-.175.29-.088.102-.186.228-.266.307-.089.088-.182.184-.078.362.103.178.46 1.013 1.013 1.503.712.632 1.313.828 1.5.916.188.089.297.075.408-.051.111-.127.476-.554.603-.744.127-.19.254-.159.429-.095.174.064 1.103.52 1.294.615.19.096.317.143.364.223.048.08.048.465-.099.876z"/>
              </svg>
              <span>WhatsApp</span>
            </a>
          </li>
          {contact.linkedin && (
            <li>
              <a
                href={contact.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 hover:text-[#0077B5] dark:hover:text-[#0a66c2] transition-colors"
                title="Ver perfil no LinkedIn"
              >
                <svg class="w-3.5 h-3.5 text-[#0077B5]" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.64a1.64 1.64 0 1 0 0 3.28 1.64 1.64 0 0 0 0-3.28Z"/>
                </svg>
                <span>LinkedIn</span>
              </a>
            </li>
          )}
          {contact.instagram && (
            <li>
              <a
                href={contact.instagram}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 hover:text-pink-600 dark:hover:text-pink-400 transition-colors"
                title="Ver portfólio no Instagram"
              >
                <svg class="w-3.5 h-3.5 text-pink-500" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                </svg>
                <span>Instagram</span>
              </a>
            </li>
          )}
          <li class="text-gray-500 pt-1">
            📍 {portfolioConfig.contact.location}
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom credits -->
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-gray-500 dark:text-gray-400">
      <p>© {currentYear} {portfolioConfig.personal.name}. Portfólio Acadêmico.</p>
      <div class="flex items-center gap-3">
        <span>Arquitetura &amp; Urbanismo</span>
        <span>•</span>
        <span class="text-rose-600 dark:text-rose-400">UNIP</span>
      </div>
    </div>
  </div>
</footer>

<script>
  function setupFooterProtectedActions() {
    const emailTrigger = document.querySelector('[data-footer-action="email"]');
    if (emailTrigger) {
      emailTrigger.addEventListener('click', (e) => {
        e.preventDefault();
        const b64 = emailTrigger.getAttribute('data-b64');
        if (b64) {
          const email = atob(b64);
          window.location.href = `mailto:${email}`;
        }
      });
    }

    const waTrigger = document.querySelector('[data-footer-action="whatsapp"]');
    if (waTrigger) {
      waTrigger.addEventListener('click', (e) => {
        e.preventDefault();
        const b64 = waTrigger.getAttribute('data-b64');
        if (b64) {
          const url = atob(b64);
          window.open(url, '_blank', 'noopener,noreferrer');
        }
      });
    }
  }

  setupFooterProtectedActions();
  document.addEventListener('astro:after-swap', setupFooterProtectedActions);
</script>
