---
import { portfolioConfig } from '@/config/portfolio.config';
const currentYear = new Date().getFullYear();
---

<footer class="w-full border-t border-white/10 dark:border-white/10 light:border-black/10 bg-obsidian-950/80 dark:bg-obsidian-950/80 light:bg-alabaster-200/80 backdrop-blur-md pt-16 pb-12 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 pb-12 border-b border-white/10 dark:border-white/10 light:border-black/10">
      <!-- Col 1: Bio & Status -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded border border-blueprint-400/40 bg-blueprint-500/10 flex items-center justify-center font-mono font-bold text-xs text-blueprint-400">
            DC
          </div>
          <div>
            <h3 class="font-display font-semibold text-lg text-white dark:text-white light:text-gray-900">
              {portfolioConfig.personal.name}
            </h3>
            <p class="font-mono text-xs text-gray-400 dark:text-gray-400 light:text-gray-600">
              {portfolioConfig.personal.academicStatus}
            </p>
          </div>
        </div>
        <p class="text-sm text-gray-300 dark:text-gray-300 light:text-gray-600 max-w-lg leading-relaxed">
          {portfolioConfig.personal.shortPitch}
        </p>
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-mono bg-emerald-500/10 border border-emerald-500/20 text-emerald-400">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>{portfolioConfig.personal.availability}</span>
        </div>
      </div>

      <!-- Col 2: Documentos & Downloads -->
      <div class="space-y-3">
        <h4 class="font-mono text-xs font-semibold tracking-wider text-blueprint-400 uppercase">
          Documentos Oficiais
        </h4>
        <ul class="space-y-2 text-sm">
          <li>
            <a href={portfolioConfig.downloads.cvUrl} download class="inline-flex items-center gap-2 text-gray-300 dark:text-gray-300 light:text-gray-700 hover:text-blueprint-400 transition-colors">
              <svg class="w-4 h-4 text-blueprint-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
              </svg>
              <span>Currículo Vitae (PDF)</span>
            </a>
          </li>
          <li>
            <a href={portfolioConfig.downloads.portfolioPdfUrl} download class="inline-flex items-center gap-2 text-gray-300 dark:text-gray-300 light:text-gray-700 hover:text-blueprint-400 transition-colors">
              <svg class="w-4 h-4 text-blueprint-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
              </svg>
              <span>Caderno de Portfólio (PDF)</span>
            </a>
          </li>
          <li>
            <a href="/projetos" class="inline-flex items-center gap-2 text-gray-300 dark:text-gray-300 light:text-gray-700 hover:text-blueprint-400 transition-colors">
              <span>Índice Completo de Projetos →</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Contato & Redes -->
      <div class="space-y-3">
        <h4 class="font-mono text-xs font-semibold tracking-wider text-blueprint-400 uppercase">
          Canais Diretos
        </h4>
        <ul class="space-y-2 text-sm text-gray-300 dark:text-gray-300 light:text-gray-700">
          <li>
            <a href={`mailto:${portfolioConfig.contact.email}`} class="hover:text-blueprint-400 transition-colors">
              {portfolioConfig.contact.email}
            </a>
          </li>
          <li>
            <a href={portfolioConfig.contact.whatsappUrl} target="_blank" rel="noopener noreferrer" class="hover:text-blueprint-400 transition-colors">
              WhatsApp: {portfolioConfig.contact.phone}
            </a>
          </li>
          <li>
            <span class="text-xs text-gray-400 font-mono block mt-1">
              {portfolioConfig.personal.location}
            </span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom credits -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-gray-400 dark:text-gray-400 light:text-gray-600">
      <p>© {currentYear} {portfolioConfig.personal.name}. Todos os direitos de projeto reservados.</p>
      <div class="flex items-center gap-4">
        <span>Arquitetura &amp; Modelagem BIM</span>
        <span>•</span>
        <span class="text-blueprint-400">Astro SSG + OpenBIM</span>
      </div>
    </div>
  </div>
</footer>

