---
import { portfolioConfig } from '@/config/portfolio.config';
const currentYear = new Date().getFullYear();
---

<footer class="w-full border-t border-rose-100 dark:border-white/10 bg-rose-50/30 dark:bg-obsidian-950/80 backdrop-blur-md pt-14 pb-10 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 pb-10 border-b border-rose-100 dark:border-white/10">
      <!-- Col 1: Bio & Status -->
      <div class="md:col-span-2 space-y-3">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded border border-rose-300 dark:border-rose-900 bg-rose-100/60 dark:bg-rose-950/40 flex items-center justify-center font-mono font-bold text-xs text-rose-600 dark:text-rose-400">
            MC
          </div>
          <div>
            <h3 class="font-display font-semibold text-base text-gray-900 dark:text-white">
              {portfolioConfig.personal.name}
            </h3>
            <p class="font-mono text-xs text-gray-500 dark:text-gray-400">
              {portfolioConfig.personal.institution} · {portfolioConfig.personal.graduationPeriod}
            </p>
          </div>
        </div>
        <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-300 max-w-lg leading-relaxed">
          {portfolioConfig.personal.shortPitch}
        </p>
      </div>

      <!-- Col 2: Documentos & Downloads -->
      <div class="space-y-3">
        <h4 class="font-mono text-xs font-semibold tracking-wider text-rose-600 dark:text-rose-400 uppercase">
          Documentos
        </h4>
        <ul class="space-y-2 text-xs font-mono">
          <li>
            <a href={portfolioConfig.downloads.cvUrl} download class="inline-flex items-center gap-2 text-gray-600 dark:text-gray-300 hover:text-rose-600 dark:hover:text-rose-300 transition-colors">
              <svg class="w-4 h-4 text-rose-600 dark:text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
              </svg>
              <span>Currículo Vitae (PDF)</span>
            </a>
          </li>
          <li>
            <a href="/projetos" class="inline-flex items-center gap-2 text-gray-600 dark:text-gray-300 hover:text-rose-600 dark:hover:text-rose-300 transition-colors">
              <span>Ver Todos os Projetos →</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Contato -->
      <div class="space-y-3">
        <h4 class="font-mono text-xs font-semibold tracking-wider text-rose-600 dark:text-rose-400 uppercase">
          Contato Direto
        </h4>
        <ul class="space-y-1.5 text-xs font-mono text-gray-600 dark:text-gray-300">
          <li>
            <a href={`mailto:${portfolioConfig.contact.email}`} class="hover:text-rose-600 dark:hover:text-rose-300 transition-colors">
              {portfolioConfig.contact.email}
            </a>
          </li>
          <li>
            <a href={portfolioConfig.contact.whatsappUrl} target="_blank" rel="noopener noreferrer" class="hover:text-rose-600 dark:hover:text-rose-300 transition-colors">
              WhatsApp: {portfolioConfig.contact.phone}
            </a>
          </li>
          <li class="text-gray-500 pt-1">
            {portfolioConfig.contact.location}
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom credits -->
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-gray-500 dark:text-gray-400">
      <p>© {currentYear} {portfolioConfig.personal.name}. Portfólio Acadêmico.</p>
      <div class="flex items-center gap-3">
        <span>Arquitetura &amp; Urbanismo</span>
        <span>•</span>
        <span class="text-rose-600 dark:text-rose-400">UNIP</span>
      </div>
    </div>
  </div>
</footer>
