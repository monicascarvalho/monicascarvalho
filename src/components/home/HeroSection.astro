---
import { portfolioConfig } from '@/config/portfolio.config';
---

<section class="relative pt-12 pb-20 md:pt-20 md:pb-28 overflow-hidden">
  <!-- Decorative subtle background glow -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-blueprint-500/10 blur-[120px] rounded-full pointer-events-none" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    <div class="max-w-3xl space-y-6">
      
      <!-- Academic Status & Availability Pill -->
      <div class="inline-flex flex-wrap items-center gap-2.5 px-3.5 py-1.5 rounded-full text-xs font-mono border border-blueprint-400/30 bg-blueprint-500/10 text-blueprint-400 backdrop-blur-md">
        <span class="w-2 h-2 rounded-full bg-blueprint-400 animate-pulse"></span>
        <span class="font-medium">{portfolioConfig.personal.academicStatus}</span>
        <span class="text-white/40">•</span>
        <span class="text-gray-300 dark:text-gray-300 light:text-gray-700">{portfolioConfig.personal.location}</span>
      </div>

      <!-- Main Headline: Name & Technical Title -->
      <div class="space-y-3">
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-display font-bold tracking-tight text-white dark:text-white light:text-gray-950 leading-[1.1]">
          {portfolioConfig.personal.name}
        </h1>
        <p class="text-xl sm:text-2xl font-light text-blueprint-400 dark:text-blueprint-400 light:text-blueprint-600 font-display">
          Arquitetura, Modelagem BIM no ArchiCAD &amp; Rotinas de Construtora
        </p>
      </div>

      <!-- Pitch conciso (3 segundos) -->
      <p class="text-base sm:text-lg text-gray-300 dark:text-gray-300 light:text-gray-700 leading-relaxed max-w-2xl">
        {portfolioConfig.personal.shortPitch}
      </p>

      <!-- Botões de Ação Imediata -->
      <div class="pt-2 flex flex-wrap items-center gap-3 sm:gap-4">
        <!-- Baixar CV -->
        <a
          href={portfolioConfig.downloads.cvUrl}
          download="Curriculo-Davi-Cruz.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-3 rounded-xl font-mono text-xs sm:text-sm font-semibold bg-blueprint-500 hover:bg-blueprint-400 text-obsidian-950 transition-all shadow-lg shadow-blueprint-500/20 active:scale-95"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>
          <span>Baixar CV (PDF)</span>
        </a>

        <!-- Baixar Caderno Resumido -->
        <a
          href={portfolioConfig.downloads.portfolioPdfUrl}
          download="Portfolio-Resumido-Davi-Cruz.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-3 rounded-xl font-mono text-xs sm:text-sm font-semibold border border-white/15 dark:border-white/15 light:border-black/15 bg-white/5 hover:bg-white/10 text-white dark:text-white light:text-gray-900 transition-all hover:border-blueprint-400/50 active:scale-95"
        >
          <svg class="w-4 h-4 text-blueprint-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
          </svg>
          <span>Caderno de Projetos (PDF)</span>
        </a>

        <!-- Contato Rápido -->
        <a
          href="#contato"
          class="inline-flex items-center gap-2 px-4 py-3 rounded-xl font-mono text-xs sm:text-sm text-gray-400 dark:text-gray-400 light:text-gray-600 hover:text-white dark:hover:text-white light:hover:text-gray-900 transition-colors"
        >
          <span>Ver Contatos &amp; Disponibilidade →</span>
        </a>
      </div>

    </div>

    <!-- 3 Mini Cards de Foco Técnico com Glassmorphism -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-16">
      {portfolioConfig.focusAreas.map((area, index) => (
        <div class="glass-card p-6 rounded-2xl relative overflow-hidden group">
          <div class="flex items-center justify-between mb-3">
            <span class="font-mono text-xs font-semibold text-blueprint-400 tracking-wider">
              {`0${index + 1}. FOCO`}
            </span>
            <div class="w-2 h-2 rounded-full bg-blueprint-400/40 group-hover:bg-blueprint-400 transition-colors"></div>
          </div>
          <h3 class="font-display font-semibold text-base sm:text-lg text-white dark:text-white light:text-gray-900 mb-2">
            {area.title}
          </h3>
          <p class="text-xs sm:text-sm text-gray-400 dark:text-gray-400 light:text-gray-600 leading-relaxed">
            {area.description}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>

