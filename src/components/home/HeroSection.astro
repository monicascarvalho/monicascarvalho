---
import { portfolioConfig } from '@/config/portfolio.config';
---

<section class="relative pt-12 pb-16 md:pt-20 md:pb-24 overflow-hidden">
  <!-- Subtle background glow in rose tone -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[550px] h-[320px] bg-rose-200/40 dark:bg-rose-950/20 blur-[120px] rounded-full pointer-events-none" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    <div class="max-w-3xl space-y-6">
      
      <!-- Academic Status & Availability Pill -->
      <div class="inline-flex flex-wrap items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-mono border border-rose-200 dark:border-rose-900/60 bg-rose-50/80 dark:bg-rose-950/40 text-rose-700 dark:text-rose-300 backdrop-blur-md shadow-sm">
        <span class="w-2 h-2 rounded-full bg-rose-500 animate-pulse"></span>
        <span class="font-medium">{portfolioConfig.personal.institution}</span>
        <span class="text-rose-300 dark:text-rose-700">•</span>
        <span>{portfolioConfig.personal.academicStatus}</span>
        <span class="text-rose-300 dark:text-rose-700">•</span>
        <span>{portfolioConfig.personal.location}</span>
      </div>

      <!-- Main Headline: Name & Title -->
      <div class="space-y-3">
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-display font-bold tracking-tight text-gray-900 dark:text-white leading-[1.1]">
          {portfolioConfig.personal.name}
        </h1>
        <p class="text-xl sm:text-2xl font-light text-rose-600 dark:text-rose-300 font-display">
          Projetos Arquitetônicos, Modelagem BIM (Archicad) &amp; Desenho Urbano
        </p>
      </div>

      <!-- Pitch conciso e objetivo -->
      <p class="text-base sm:text-lg text-gray-600 dark:text-gray-300 leading-relaxed max-w-2xl">
        {portfolioConfig.personal.shortPitch}
      </p>

      <!-- Badges de Destaque -->
      <div class="flex flex-wrap gap-2 pt-1">
        {portfolioConfig.personal.badges.map((badge) => (
          <span class="px-2.5 py-1 rounded-md text-xs font-mono bg-stone-100 dark:bg-white/5 border border-stone-200 dark:border-white/10 text-stone-700 dark:text-stone-300">
            {badge}
          </span>
        ))}
      </div>

      <!-- Botões de Ação Imediata -->
      <div class="pt-3 flex flex-wrap items-center gap-3 sm:gap-4">
        <!-- Baixar CV -->
        <a
          href={portfolioConfig.downloads.cvUrl}
          download="Curriculo-Monica-Carvalho.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-3 rounded-xl font-mono text-xs sm:text-sm font-semibold bg-rose-600 hover:bg-rose-700 text-white transition-all shadow-md shadow-rose-600/20 active:scale-95"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>
          <span>Baixar Currículo (PDF)</span>
        </a>

        <!-- Ver Projetos -->
        <a
          href="#projetos"
          class="inline-flex items-center gap-2 px-5 py-3 rounded-xl font-mono text-xs sm:text-sm font-medium border border-rose-200 dark:border-rose-900/60 bg-white dark:bg-white/5 hover:bg-rose-50 dark:hover:bg-rose-950/30 text-gray-800 dark:text-gray-200 hover:border-rose-300 transition-all active:scale-95 shadow-sm"
        >
          <span>Explorar Projetos Acadêmicos ↓</span>
        </a>

        <!-- WhatsApp -->
        <a
          href={portfolioConfig.contact.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-3 rounded-xl font-mono text-xs sm:text-sm text-gray-600 dark:text-gray-400 hover:text-rose-600 dark:hover:text-rose-300 transition-colors"
        >
          <span>Falar no WhatsApp →</span>
        </a>
      </div>

    </div>

    <!-- 3 Mini Cards de Competência Objetiva -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 pt-14">
      <div class="glass-card p-6 rounded-2xl relative overflow-hidden group">
        <div class="flex items-center justify-between mb-3">
          <span class="font-mono text-xs font-semibold text-rose-600 dark:text-rose-400 tracking-wider">
            01. MODELAGEM BIM
          </span>
          <div class="w-2 h-2 rounded-full bg-rose-400/40 group-hover:bg-rose-500 transition-colors"></div>
        </div>
        <h3 class="font-display font-semibold text-base sm:text-lg text-gray-900 dark:text-white mb-2">
          Archicad &amp; Desenho Técnico
        </h3>
        <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
          Estudos preliminares, cortes, elevações, modelagem 3D e pranchas executivas integradas no fluxo BIM.
        </p>
      </div>

      <div class="glass-card p-6 rounded-2xl relative overflow-hidden group">
        <div class="flex items-center justify-between mb-3">
          <span class="font-mono text-xs font-semibold text-rose-600 dark:text-rose-400 tracking-wider">
            02. DESENHO URBANO
          </span>
          <div class="w-2 h-2 rounded-full bg-rose-400/40 group-hover:bg-rose-500 transition-colors"></div>
        </div>
        <h3 class="font-display font-semibold text-base sm:text-lg text-gray-900 dark:text-white mb-2">
          QGIS &amp; Análise Territorial
        </h3>
        <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
          Morfologia urbana, zoneamento, requalificação de espaços públicos, conforto bioclimático e acessibilidade NBR 9050.
        </p>
      </div>

      <div class="glass-card p-6 rounded-2xl relative overflow-hidden group">
        <div class="flex items-center justify-between mb-3">
          <span class="font-mono text-xs font-semibold text-rose-600 dark:text-rose-400 tracking-wider">
            03. SETOR IMOBILIÁRIO
          </span>
          <div class="w-2 h-2 rounded-full bg-rose-400/40 group-hover:bg-rose-500 transition-colors"></div>
        </div>
        <h3 class="font-display font-semibold text-base sm:text-lg text-gray-900 dark:text-white mb-2">
          11+ Anos em Incorporadoras
        </h3>
        <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
          Experiência em Plano&amp;Plano, Queiroz Galvão, Rossi e PDG com financiamento imobiliário, contratos e regularização cartorial (CRI).
        </p>
      </div>
    </div>

  </div>
</section>
