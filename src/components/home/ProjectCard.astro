---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { data, slug } = project;
---

<article 
  class="project-item glass-card rounded-2xl overflow-hidden flex flex-col justify-between group transition-all duration-300 shadow-sm"
  data-category={data.category}
>
  <div>
    <!-- Project Cover Image with Badge -->
    <a href={`/projetos/${slug}`} class="block relative aspect-[16/10] overflow-hidden bg-stone-100 dark:bg-obsidian-900 border-b border-rose-100 dark:border-white/10">
      <img
        src={data.heroImage}
        alt={data.heroImageAlt}
        class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
      />
      
      <!-- Category Badge overlay -->
      <div class="absolute top-3 left-3">
        <span class="inline-flex items-center px-2.5 py-1 rounded-md text-[11px] font-mono font-medium glass-badge shadow-sm">
          {data.category}
        </span>
      </div>

      <!-- Year badge -->
      <div class="absolute top-3 right-3">
        <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-mono bg-white/90 dark:bg-obsidian-950/80 text-gray-700 dark:text-gray-300 border border-black/5 dark:border-white/10 backdrop-blur-md shadow-sm">
          {data.year}
        </span>
      </div>
    </a>

    <!-- Card Content -->
    <div class="p-6 space-y-4">
      <!-- Title & Location -->
      <div class="space-y-1">
        <div class="flex items-center justify-between text-xs font-mono text-gray-500 dark:text-gray-400">
          <span>{data.location}</span>
          <span class="text-rose-600 dark:text-rose-400 font-semibold">{data.sheets.length} pranchas</span>
        </div>

        <h3 class="font-display font-bold text-xl text-gray-900 dark:text-white group-hover:text-rose-600 dark:group-hover:text-rose-300 transition-colors">
          <a href={`/projetos/${slug}`}>
            {data.title}
          </a>
        </h3>
      </div>

      <!-- Short Description -->
      <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-300 line-clamp-2 leading-relaxed">
        {data.shortDescription}
      </p>

      <!-- Softwares Badges -->
      <div class="flex flex-wrap gap-1.5 pt-1">
        {data.softwares.map((sw) => (
          <span class={`px-2 py-0.5 rounded text-[10px] font-mono ${sw.includes('Archicad') || sw.includes('QGIS') ? 'bg-rose-50 dark:bg-rose-950/40 text-rose-700 dark:text-rose-300 border border-rose-200 dark:border-rose-900/50 font-semibold' : 'bg-stone-100 dark:bg-white/5 text-stone-700 dark:text-stone-300 border border-stone-200 dark:border-white/10'}`}>
            {sw}
          </span>
        ))}
      </div>
    </div>
  </div>

  <!-- Bottom Action Link -->
  <div class="p-6 pt-0 border-t border-rose-100/60 dark:border-white/5 mt-4">
    <a
      href={`/projetos/${slug}`}
      class="inline-flex items-center justify-between w-full pt-4 font-mono text-xs font-semibold text-rose-600 dark:text-rose-400 hover:text-rose-700 dark:hover:text-rose-300 transition-colors group/link"
    >
      <span>Ver Pranchas &amp; Memorial</span>
      <span class="transform group-hover/link:translate-x-1 transition-transform">→</span>
    </a>
  </div>
</article>
