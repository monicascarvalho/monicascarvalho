---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { data, slug } = project;
---

<article 
  class="project-item glass-card rounded-2xl overflow-hidden flex flex-col justify-between group transition-all duration-300"
  data-category={data.category}
>
  <div>
    <!-- Project Cover Image with Glass Overlay Badge -->
    <a href={`/projetos/${slug}`} class="block relative aspect-[16/10] overflow-hidden bg-obsidian-900 border-b border-white/10 dark:border-white/10 light:border-black/5">
      <img
        src={data.heroImage}
        alt={data.heroImageAlt}
        class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
      />
      
      <!-- Category Badge overlay -->
      <div class="absolute top-3 left-3">
        <span class="inline-flex items-center px-2.5 py-1 rounded-md text-[11px] font-mono font-medium glass-badge">
          {data.category}
        </span>
      </div>

      <!-- Year / Semester badge -->
      <div class="absolute top-3 right-3">
        <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-mono bg-obsidian-950/80 text-gray-300 border border-white/10 backdrop-blur-md">
          {data.year} • {data.semester}
        </span>
      </div>
    </a>

    <!-- Card Content -->
    <div class="p-6 space-y-4">
      <!-- Title & Location -->
      <div class="space-y-1">
        <div class="flex items-center justify-between">
          <span class="font-mono text-xs text-gray-400 dark:text-gray-400 light:text-gray-500">
            {data.location}
          </span>
          <span class="font-mono text-xs font-semibold text-blueprint-400">
            {data.builtArea}
          </span>
        </div>

        <h3 class="font-display font-bold text-xl text-white dark:text-white light:text-gray-900 group-hover:text-blueprint-400 transition-colors">
          <a href={`/projetos/${slug}`}>
            {data.title}
          </a>
        </h3>
      </div>

      <!-- Short Description -->
      <p class="text-xs sm:text-sm text-gray-300 dark:text-gray-300 light:text-gray-600 line-clamp-2 leading-relaxed">
        {data.shortDescription}
      </p>

      <!-- Softwares Badges -->
      <div class="flex flex-wrap gap-1.5 pt-1">
        {data.softwares.map((sw) => (
          <span class={`px-2 py-0.5 rounded text-[10px] font-mono ${sw.includes('ArchiCAD') ? 'bg-blueprint-500/20 text-blueprint-400 border border-blueprint-400/40 font-semibold' : 'bg-white/5 dark:bg-white/5 light:bg-black/5 text-gray-300 dark:text-gray-300 light:text-gray-700 border border-white/10 dark:border-white/10 light:border-black/10'}`}>
            {sw}
          </span>
        ))}
      </div>
    </div>
  </div>

  <!-- Bottom Action Link -->
  <div class="p-6 pt-0 border-t border-white/5 dark:border-white/5 light:border-black/5 mt-4">
    <a
      href={`/projetos/${slug}`}
      class="inline-flex items-center justify-between w-full pt-4 font-mono text-xs font-semibold text-blueprint-400 hover:text-white dark:hover:text-white light:hover:text-gray-900 transition-colors group/link"
    >
      <span>Ver Documentação &amp; Pranchas</span>
      <span class="transform group-hover/link:translate-x-1 transition-transform">→</span>
    </a>
  </div>
</article>

