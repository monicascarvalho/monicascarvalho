---
import { portfolioConfig } from '@/config/portfolio.config';
const { contact, personal, downloads } = portfolioConfig;
---

<section id="contato" class="py-20 md:py-28 relative scroll-mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="glass-card p-8 sm:p-12 md:p-16 rounded-3xl relative overflow-hidden border border-white/10 dark:border-white/10 light:border-black/10">
      
      <!-- Subtle background glow -->
      <div class="absolute -right-20 -bottom-20 w-96 h-96 bg-blueprint-500/10 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 relative z-10">
        
        <!-- Left: Pitch & Availability -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-medium bg-emerald-500/10 border border-emerald-500/20 text-emerald-400">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>{personal.availability}</span>
          </div>

          <h2 class="text-3xl sm:text-4xl md:text-5xl font-display font-bold text-white dark:text-white light:text-gray-950 leading-tight">
            Vamos conversar sobre novos projetos e oportunidades?
          </h2>

          <p class="text-sm sm:text-base text-gray-300 dark:text-gray-300 light:text-gray-700 leading-relaxed max-w-xl">
            Estou em busca de posições em escritórios de arquitetura, construtoras ou incorporadoras onde possa aplicar modelagem paramétrica no ArchiCAD, desenvolvimento executivo e rotinas de aprovação técnica.
          </p>

          <!-- Localização & Modelo de Trabalho -->
          <div class="pt-2 flex flex-wrap gap-4 text-xs font-mono text-gray-400 dark:text-gray-400 light:text-gray-600">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-blueprint-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <span>{personal.location}</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-blueprint-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <span>Carga Horária: Estágio (30h/sem) ou Integral Júnior</span>
            </div>
          </div>
        </div>

        <!-- Right: Contact Direct Cards -->
        <div class="lg:col-span-5 flex flex-col justify-center space-y-4">
          
          <!-- E-mail card com botão de copiar -->
          <div class="p-4 rounded-xl glass-spec-item flex items-center justify-between">
            <div class="space-y-0.5">
              <span class="font-mono text-[10px] text-gray-400 block uppercase">E-mail Direto</span>
              <a href={`mailto:${contact.email}`} class="text-xs sm:text-sm font-semibold text-white dark:text-white light:text-gray-900 hover:text-blueprint-400 transition-colors">
                {contact.email}
              </a>
            </div>
            <button
              id="copy-email-btn"
              type="button"
              data-email={contact.email}
              class="p-2 rounded-lg border border-white/10 hover:border-blueprint-400/50 text-gray-400 hover:text-blueprint-400 transition-colors"
              title="Copiar e-mail para a área de transferência"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
              </svg>
            </button>
          </div>

          <!-- WhatsApp Card -->
          <a
            href={contact.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="p-4 rounded-xl glass-spec-item flex items-center justify-between group hover:border-emerald-500/40 transition-colors"
          >
            <div class="space-y-0.5">
              <span class="font-mono text-[10px] text-gray-400 block uppercase">WhatsApp Profissional</span>
              <span class="text-xs sm:text-sm font-semibold text-white dark:text-white light:text-gray-900 group-hover:text-emerald-400 transition-colors">
                {contact.phone}
              </span>
            </div>
            <span class="text-xs font-mono text-emerald-400 font-semibold">Iniciar Conversa →</span>
          </a>

          <!-- Downloads de PDF no Contato -->
          <div class="pt-2 grid grid-cols-2 gap-3">
            <a
              href={downloads.cvUrl}
              download
              class="flex items-center justify-center gap-2 p-3 rounded-xl font-mono text-xs font-semibold bg-blueprint-500 text-obsidian-950 hover:bg-blueprint-400 transition-all text-center shadow-md shadow-blueprint-500/10"
            >
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
              </svg>
              <span>Baixar CV (PDF)</span>
            </a>

            <a
              href={downloads.portfolioPdfUrl}
              download
              class="flex items-center justify-center gap-2 p-3 rounded-xl font-mono text-xs font-semibold border border-white/15 bg-white/5 hover:bg-white/10 text-white dark:text-white light:text-gray-900 transition-all text-center"
            >
              <svg class="w-3.5 h-3.5 text-blueprint-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
              </svg>
              <span>Caderno PDF</span>
            </a>
          </div>

        </div>

      </div>

    </div>

  </div>
</section>

<script is:inline>
  const copyBtn = document.getElementById('copy-email-btn');
  if (copyBtn) {
    copyBtn.addEventListener('click', () => {
      const email = copyBtn.getAttribute('data-email');
      if (email) {
        navigator.clipboard.writeText(email).then(() => {
          copyBtn.innerHTML = '<span class="text-xs text-emerald-400 font-mono font-bold">Copiado!</span>';
          setTimeout(() => {
            copyBtn.innerHTML = '<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>';
          }, 2000);
        });
      }
    });
  }
</script>

