---
import { portfolioConfig } from '@/config/portfolio.config';
const { contact, personal, downloads } = portfolioConfig;
---

<section id="contato" class="py-16 md:py-24 relative scroll-mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="glass-card p-8 sm:p-12 md:p-14 rounded-3xl relative overflow-hidden border border-rose-200/80 dark:border-white/10 shadow-sm">
      
      <!-- Subtle background rose glow -->
      <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-rose-200/30 dark:bg-rose-950/20 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 relative z-10">
        
        <!-- Left: Pitch & Availability -->
        <div class="lg:col-span-7 space-y-5">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-medium bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900/50 text-rose-700 dark:text-rose-300">
            <span class="w-2 h-2 rounded-full bg-rose-500 animate-pulse"></span>
            <span>{personal.availability}</span>
          </div>

          <h2 class="text-3xl sm:text-4xl font-display font-bold text-gray-900 dark:text-white leading-tight">
            Contato &amp; Oportunidades Profissionais
          </h2>

          <p class="text-sm sm:text-base text-gray-600 dark:text-gray-300 leading-relaxed max-w-xl">
            Estou em busca de posições em escritórios de arquitetura, desenho urbano ou construtoras onde possa agregar minha maturidade de mais de 11 anos no setor imobiliário, aliada ao domínio de Archicad (BIM), QGIS e desenho técnico.
          </p>

          <!-- Localização & Formato -->
          <div class="pt-2 flex flex-wrap gap-4 text-xs font-mono text-gray-600 dark:text-gray-400">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-rose-600 dark:text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <span>{personal.location}</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-rose-600 dark:text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <span>UNIP Noturno (Disponibilidade Diurna para Estágio)</span>
            </div>
          </div>
        </div>

        <!-- Right: Contact Direct Cards -->
        <div class="lg:col-span-5 flex flex-col justify-center space-y-3.5">
          
          <!-- 1. LinkedIn Card (Primary Professional Channel - Spam-Proof) -->
          {contact.linkedin && (
            <a
              href={contact.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="p-4 rounded-xl border border-stone-200 dark:border-white/10 bg-white dark:bg-white/5 flex items-center justify-between group hover:border-rose-400 transition-all shadow-sm"
              title="Abrir perfil profissional no LinkedIn"
            >
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-[#0a66c2]/10 dark:bg-[#0a66c2]/20 flex items-center justify-center text-[#0a66c2] dark:text-[#388fd8]">
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                </div>
                <div class="space-y-0.5">
                  <span class="font-mono text-[10px] text-gray-500 dark:text-gray-400 block uppercase">Rede Profissional</span>
                  <span class="text-xs sm:text-sm font-semibold text-gray-900 dark:text-white group-hover:text-rose-600 dark:group-hover:text-rose-300 transition-colors">
                    LinkedIn / Monica Carvalho
                  </span>
                </div>
              </div>
              <span class="text-xs font-mono text-rose-600 dark:text-rose-400 font-semibold group-hover:translate-x-0.5 transition-transform">Conectar →</span>
            </a>
          )}

          <!-- 2. E-mail Card (Obfuscated against scrapers) -->
          <div class="p-4 rounded-xl border border-stone-200 dark:border-white/10 bg-white dark:bg-white/5 flex items-center justify-between shadow-sm">
            <div class="space-y-0.5">
              <span class="font-mono text-[10px] text-gray-500 dark:text-gray-400 block uppercase">E-mail Direto</span>
              <a
                id="safe-email-link"
                href="#contato"
                data-u="bW9uaWNhLmNhcnZhbGhvNjA="
                data-d="Z21haWwuY29t"
                class="text-xs sm:text-sm font-semibold text-gray-900 dark:text-white hover:text-rose-600 dark:hover:text-rose-300 transition-colors"
              >
                <span class="email-placeholder font-mono text-xs text-stone-500">monica.carvalho... (clique para exibir)</span>
              </a>
            </div>
            <button
              id="copy-email-btn"
              type="button"
              class="p-2 rounded-lg border border-stone-200 dark:border-white/10 hover:border-rose-300 text-gray-500 hover:text-rose-600 transition-colors"
              title="Copiar e-mail"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
              </svg>
            </button>
          </div>

          <!-- 3. WhatsApp Card (Masked number, safe direct action) -->
          <a
            id="safe-wa-link"
            href="#contato"
            data-p="NTUxMTk3NjI2NDY4Ng=="
            target="_blank"
            rel="noopener noreferrer"
            class="p-4 rounded-xl border border-stone-200 dark:border-white/10 bg-white dark:bg-white/5 flex items-center justify-between group hover:border-rose-400 transition-colors shadow-sm"
          >
            <div class="space-y-0.5">
              <span class="font-mono text-[10px] text-gray-500 dark:text-gray-400 block uppercase">Mensagem Direta</span>
              <span class="text-xs sm:text-sm font-semibold text-gray-900 dark:text-white group-hover:text-rose-600 dark:group-hover:text-rose-300 transition-colors">
                Iniciar Conversa no WhatsApp
              </span>
            </div>
            <span class="text-xs font-mono text-rose-600 dark:text-rose-400 font-semibold group-hover:translate-x-0.5 transition-transform">Abrir Chat →</span>
          </a>

          <!-- 4. Instagram Card (Automatically surfaced when populated in config) -->
          {contact.instagram && (
            <a
              href={contact.instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="p-4 rounded-xl border border-stone-200 dark:border-white/10 bg-white dark:bg-white/5 flex items-center justify-between group hover:border-rose-400 transition-colors shadow-sm"
            >
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-pink-500/10 flex items-center justify-center text-pink-600 dark:text-pink-400">
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                </div>
                <div class="space-y-0.5">
                  <span class="font-mono text-[10px] text-gray-500 dark:text-gray-400 block uppercase">Portfólio Visual</span>
                  <span class="text-xs sm:text-sm font-semibold text-gray-900 dark:text-white group-hover:text-rose-600 dark:group-hover:text-rose-300 transition-colors">
                    Instagram
                  </span>
                </div>
              </div>
              <span class="text-xs font-mono text-rose-600 dark:text-rose-400 font-semibold group-hover:translate-x-0.5 transition-transform">Acessar →</span>
            </a>
          )}

          <!-- 5. Botão de Download CV -->
          <div class="pt-1">
            <a
              href={downloads.cvUrl}
              download="Curriculo-Monica-Carvalho.pdf"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center gap-2 p-3.5 rounded-xl font-mono text-xs font-semibold bg-rose-600 hover:bg-rose-700 text-white transition-all text-center shadow-md shadow-rose-600/20 active:scale-[0.99]"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
              </svg>
              <span>Baixar Currículo Vitae (PDF)</span>
            </a>
          </div>

        </div>

      </div>

    </div>

  </div>
</section>

<!-- Client-side anti-scraping hydration script -->
<script is:inline>
  (function () {
    // 1. Email decode & hydrate
    const emailLink = document.getElementById('safe-email-link');
    const copyBtn = document.getElementById('copy-email-btn');
    let decodedEmail = '';

    if (emailLink) {
      try {
        const u = atob(emailLink.getAttribute('data-u') || '');
        const d = atob(emailLink.getAttribute('data-d') || '');
        decodedEmail = `${u}@${d}`;
        emailLink.textContent = decodedEmail;
        emailLink.setAttribute('href', `mailto:${decodedEmail}`);
      } catch (e) {
        // Fallback
      }
    }

    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        if (!decodedEmail && emailLink) {
          try {
            decodedEmail = atob(emailLink.getAttribute('data-u')) + '@' + atob(emailLink.getAttribute('data-d'));
          } catch(e) {}
        }
        if (decodedEmail) {
          navigator.clipboard.writeText(decodedEmail).then(() => {
            copyBtn.innerHTML = '<span class="text-xs text-rose-600 font-mono font-bold">Copiado!</span>';
            setTimeout(() => {
              copyBtn.innerHTML = '<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>';
            }, 2000);
          });
        }
      });
    }

    // 2. WhatsApp decode & hydrate
    const waLink = document.getElementById('safe-wa-link');
    if (waLink) {
      try {
        const p = atob(waLink.getAttribute('data-p') || '');
        const defaultMsg = encodeURIComponent("Olá Monica, vi seu portfólio de arquitetura e gostaria de conversar.");
        waLink.setAttribute('href', `https://wa.me/${p}?text=${defaultMsg}`);
      } catch (e) {
        // Fallback
      }
    }
  })();
</script>
