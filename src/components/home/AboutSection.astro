---
import { portfolioConfig } from '@/config/portfolio.config';
const { personal } = portfolioConfig;
---

<section id="sobre" class="py-16 md:py-24 relative scroll-mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      
      <!-- Coluna Esquerda: Cartão Resumo de Identidade -->
      <div class="lg:col-span-5 space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-medium bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900/50 text-rose-700 dark:text-rose-300">
          <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
          <span>Apresentação &amp; Formação</span>
        </div>
        
        <h2 class="text-3xl sm:text-4xl font-display font-bold text-gray-900 dark:text-white">
          Sobre Monica Carvalho
        </h2>

        <!-- Cartão Editorial com dados acadêmicos -->
        <div class="glass-card p-6 sm:p-7 rounded-2xl space-y-5">
          <div class="flex items-center justify-between pb-4 border-b border-rose-100 dark:border-white/10">
            <div>
              <h4 class="font-display font-bold text-xl text-gray-900 dark:text-white">{personal.fullName}</h4>
              <p class="font-mono text-xs text-rose-600 dark:text-rose-400 mt-0.5">{personal.role}</p>
            </div>
            <div class="w-10 h-10 rounded-lg bg-rose-50 dark:bg-rose-950/50 border border-rose-200 dark:border-rose-900/60 flex items-center justify-center font-mono font-bold text-rose-600 dark:text-rose-300 text-sm">
              MC
            </div>
          </div>

          <!-- Formações Acadêmicas do CV -->
          <div class="space-y-3">
            <div class="space-y-1">
              <span class="font-mono text-[11px] text-gray-500 dark:text-gray-400 block uppercase">Graduação em Andamento</span>
              <p class="text-sm font-semibold text-gray-900 dark:text-white">Bacharelado em Arquitetura e Urbanismo</p>
              <p class="text-xs text-gray-600 dark:text-gray-300 font-mono">Universidade Paulista (UNIP) · 2023 – 2027 (Noturno)</p>
            </div>

            <div class="space-y-1 pt-2 border-t border-rose-100/60 dark:border-white/5">
              <span class="font-mono text-[11px] text-gray-500 dark:text-gray-400 block uppercase">Graduação Anterior</span>
              <p class="text-sm font-semibold text-gray-900 dark:text-white">Bacharel em Administração de Empresas</p>
              <p class="text-xs text-gray-600 dark:text-gray-300 font-mono">Faculdade Unibero · 2004 – 2008</p>
            </div>
          </div>
          
          <div class="pt-4 border-t border-rose-100/60 dark:border-white/5 flex items-center justify-between text-xs font-mono text-gray-500 dark:text-gray-400">
            <span>{personal.location}</span>
            <span class="text-emerald-600 dark:text-emerald-400 font-medium flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              {personal.availability}
            </span>
          </div>
        </div>
      </div>

      <!-- Coluna Direita: Narrativa Concisa e Cursos -->
      <div class="lg:col-span-7 space-y-6">
        <div class="glass-card p-6 sm:p-8 rounded-2xl space-y-4">
          <h3 class="font-display font-bold text-lg text-gray-900 dark:text-white">
            Transição de Carreira &amp; Visão de Mercado
          </h3>
          <p class="text-sm sm:text-base text-gray-600 dark:text-gray-300 leading-relaxed">
            Em transição de carreira para a atuação plena em Projetos Arquitetônicos e Desenho Urbano, uno a graduação na Universidade Paulista (UNIP) a uma sólida bagagem de mais de 11 anos no setor imobiliário corporativo.
          </p>
          <p class="text-sm sm:text-base text-gray-600 dark:text-gray-300 leading-relaxed">
            A vivência em construtoras e incorporadoras como <strong>Plano&amp;Plano</strong>, <strong>Queiroz Galvão</strong>, <strong>Rossi</strong> e <strong>PDG</strong> proporcionou domínio de processos de financiamento imobiliário (PJ e repasses), conformidade contratual e registro de escrituras em Cartórios de Imóveis (CRI). Hoje, aplico essa maturidade ao desenvolvimento de projetos em Archicad (BIM) e estudos territoriais no QGIS, com olhar atento à viabilidade técnica e às normas de acessibilidade (NBR 9050).
          </p>
        </div>

        <!-- Cursos Extracurriculares Reais -->
        <div class="glass-card p-6 sm:p-8 rounded-2xl space-y-4">
          <h3 class="font-mono text-xs font-semibold tracking-wider text-rose-600 dark:text-rose-400 uppercase">
            Cursos Extracurriculares &amp; Aperfeiçoamento
          </h3>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
            <div class="p-3 rounded-lg border border-stone-200/80 dark:border-white/10 bg-white/60 dark:bg-white/5 space-y-1">
              <span class="font-mono font-semibold text-rose-600 dark:text-rose-400">Archicad</span>
              <p class="text-gray-600 dark:text-gray-300">Modelagem BIM &amp; Documentação Técnica Integrada</p>
            </div>

            <div class="p-3 rounded-lg border border-stone-200/80 dark:border-white/10 bg-white/60 dark:bg-white/5 space-y-1">
              <span class="font-mono font-semibold text-rose-600 dark:text-rose-400">QGIS</span>
              <p class="text-gray-600 dark:text-gray-300">Planejamento Urbano, Geoprocessamento &amp; Análise Territorial</p>
            </div>

            <div class="p-3 rounded-lg border border-stone-200/80 dark:border-white/10 bg-white/60 dark:bg-white/5 space-y-1">
              <span class="font-mono font-semibold text-rose-600 dark:text-rose-400">AutoCAD</span>
              <p class="text-gray-600 dark:text-gray-300">Desenho Técnico 2D, Cotas e Detalhamento Normativo</p>
            </div>

            <div class="p-3 rounded-lg border border-stone-200/80 dark:border-white/10 bg-white/60 dark:bg-white/5 space-y-1">
              <span class="font-mono font-semibold text-rose-600 dark:text-rose-400">Canva / Gráfico</span>
              <p class="text-gray-600 dark:text-gray-300">Diagramação de Pranchas &amp; Apresentação Visual de Projetos</p>
            </div>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>
