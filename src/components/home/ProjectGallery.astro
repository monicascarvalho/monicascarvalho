---
import type { CollectionEntry } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
const uniqueCategories = ['Todos', ...new Set(projects.map(p => p.data.category))];
---

<section id="projetos" class="py-16 md:py-24 relative scroll-mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header & Filter Bar -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <div class="space-y-3 max-w-xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-medium bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900/50 text-rose-700 dark:text-rose-300">
          <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
          <span>Projetos Acadêmicos UNIP</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-display font-bold text-gray-900 dark:text-white">
          Projetos em Destaque
        </h2>
        <p class="text-sm text-gray-600 dark:text-gray-300">
          Trabalhos acadêmicos com foco em modelagem BIM no Archicad, acessibilidade NBR 9050, conforto ambiental e desenho urbano.
        </p>
      </div>

      <!-- Filter Buttons -->
      <div class="flex flex-wrap gap-2" id="gallery-filter-buttons">
        {uniqueCategories.map((cat, idx) => (
          <button
            type="button"
            data-filter={cat}
            class={`px-3.5 py-1.5 rounded-lg text-xs font-mono transition-all filter-btn ${idx === 0 ? 'bg-rose-600 text-white font-semibold active shadow-sm' : 'border border-stone-200 dark:border-white/10 bg-white dark:bg-white/5 text-gray-700 dark:text-gray-300 hover:text-rose-600 hover:border-rose-300'}`}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>

    <!-- Projects Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8" id="projects-grid">
      {projects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>

  </div>
</section>

<script is:inline>
  (function () {
    const filterButtons = document.querySelectorAll('#gallery-filter-buttons .filter-btn');
    const projectItems = document.querySelectorAll('#projects-grid .project-item');

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');

        // Update active button state
        filterButtons.forEach(b => {
          b.classList.remove('bg-rose-600', 'text-white', 'font-semibold', 'active', 'shadow-sm');
          b.classList.add('border', 'border-stone-200', 'dark:border-white/10', 'bg-white', 'dark:bg-white/5', 'text-gray-700', 'dark:text-gray-300');
        });
        btn.classList.add('bg-rose-600', 'text-white', 'font-semibold', 'active', 'shadow-sm');
        btn.classList.remove('border', 'border-stone-200', 'dark:border-white/10', 'bg-white', 'dark:bg-white/5', 'text-gray-700', 'dark:text-gray-300');

        // Filter cards
        projectItems.forEach(card => {
          const category = card.getAttribute('data-category');
          if (filter === 'Todos' || category === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  })();
</script>
