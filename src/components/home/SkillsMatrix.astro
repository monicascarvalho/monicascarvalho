---
import { portfolioConfig } from '@/config/portfolio.config';
const { skills } = portfolioConfig;
---

<section id="habilidades" class="py-16 md:py-24 relative scroll-mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl space-y-4 mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-medium bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900/50 text-rose-700 dark:text-rose-300">
        <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
        <span>Competências Práticas &amp; Ferramentas</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-display font-bold text-gray-900 dark:text-white">
        Matriz de Conhecimentos
      </h2>
      <p class="text-sm sm:text-base text-gray-600 dark:text-gray-300 leading-relaxed">
        Organizada por aplicação prática no desenvolvimento projetual e na rotina de escritórios de arquitetura e urbanismo.
      </p>
    </div>

    <!-- Skills Grid by Categories -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {skills.map((category) => (
        <div class="glass-card p-6 sm:p-8 rounded-2xl flex flex-col justify-between">
          <div class="space-y-5">
            <!-- Category Title -->
            <div class="flex items-center justify-between pb-3 border-b border-rose-100 dark:border-white/10">
              <h3 class="font-display font-bold text-lg text-gray-900 dark:text-white">
                {category.category}
              </h3>
              <span class="w-2 h-2 rounded-full bg-rose-500"></span>
            </div>

            <!-- Tools List -->
            <div class="space-y-3">
              {category.items.map((tool) => (
                <div class="p-3.5 rounded-xl border border-stone-200/80 dark:border-white/10 bg-white/60 dark:bg-white/5 hover:border-rose-300 dark:hover:border-rose-800 transition-colors">
                  <div class="flex items-center justify-between mb-1">
                    <span class={`font-semibold text-sm ${tool.highlight ? 'text-rose-600 dark:text-rose-300' : 'text-gray-900 dark:text-white'}`}>
                      {tool.name}
                    </span>
                    {tool.highlight && (
                      <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-rose-50 dark:bg-rose-950/50 text-rose-700 dark:text-rose-300 border border-rose-200 dark:border-rose-900/60 font-semibold">
                        Destaque
                      </span>
                    )}
                  </div>
                  <p class="text-xs text-gray-600 dark:text-gray-300 leading-relaxed">
                    {tool.description}
                  </p>
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
