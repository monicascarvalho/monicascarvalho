---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Página Não Encontrada | Monica Carvalho" isHome={false}>
  <div class="min-h-[60vh] flex items-center justify-center py-20 px-4">
    <div class="glass-card p-10 sm:p-14 rounded-3xl max-w-lg text-center space-y-6 border border-stone-200/80 dark:border-white/10 bg-white/80 dark:bg-obsidian-900/80 shadow-sm">
      <div class="w-16 h-16 rounded-2xl bg-rose-50 dark:bg-rose-950/60 border border-rose-200 dark:border-rose-900/50 text-rose-600 dark:text-rose-400 font-mono font-bold text-2xl flex items-center justify-center mx-auto">
        404
      </div>
      <div class="space-y-2">
        <h1 class="text-2xl sm:text-3xl font-display font-bold text-stone-900 dark:text-white">
          Prancha Não Encontrada
        </h1>
        <p class="text-sm text-stone-600 dark:text-stone-300">
          O projeto ou documento solicitado não está disponível neste endereço ou foi remanejado.
        </p>
      </div>
      <div class="pt-2">
        <a
          href="/"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-mono text-xs font-semibold bg-rose-600 text-white hover:bg-rose-700 transition-all shadow-sm"
        >
          <span>← Retornar ao Início</span>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
