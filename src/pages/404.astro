---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Página não encontrada | Davi Cruz" isHome={false}>
  <div class="min-h-[60vh] flex items-center justify-center py-20 px-4">
    <div class="glass-card p-10 sm:p-14 rounded-3xl max-w-lg text-center space-y-6">
      <div class="w-16 h-16 rounded-2xl bg-blueprint-500/10 border border-blueprint-400/30 text-blueprint-400 font-mono font-bold text-2xl flex items-center justify-center mx-auto">
        404
      </div>
      <div class="space-y-2">
        <h1 class="text-2xl sm:text-3xl font-display font-bold text-white dark:text-white light:text-gray-950">
          Prancha Não Encontrada
        </h1>
        <p class="text-sm text-gray-400 dark:text-gray-400 light:text-gray-600">
          O projeto ou documento solicitado não está disponível neste endereço ou foi movido na documentação.
        </p>
      </div>
      <div class="pt-2">
        <a
          href="/"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-mono text-xs font-semibold bg-blueprint-500 text-obsidian-950 hover:bg-blueprint-400 transition-all"
        >
          <span>← Retornar à Página Inicial</span>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
