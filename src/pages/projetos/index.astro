---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectGallery from '@/components/home/ProjectGallery.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Acervo Completo de Projetos | Davi Cruz"
  description="Catálogo completo de projetos acadêmicos e executivos com foco em BIM, ArchiCAD e prática construtiva."
  isHome={false}
>
  <div class="py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-4">
      <div class="space-y-2">
        <span class="font-mono text-xs text-blueprint-400 uppercase tracking-wider">
          Índice Cronológico &amp; Tipológico
        </span>
        <h1 class="text-4xl sm:text-5xl font-display font-bold text-white dark:text-white light:text-gray-950">
          Todos os Projetos
        </h1>
        <p class="text-gray-300 dark:text-gray-300 light:text-gray-600 max-w-2xl text-sm sm:text-base">
          Explore o catálogo estruturado por tipologias, contendo fichas técnicas detalhadas, pranchas normatizadas e detalhes construtivos em escala 1:10.
        </p>
      </div>
    </div>

    <ProjectGallery projects={sortedProjects} />
  </div>
</BaseLayout>

